  b.gr_asian_all,  b.gr_asian_male,  b.gr_asian_female,
  b.gr_black_all,  b.gr_black_male,  b.gr_black_female,
  b.gr_hispanic_all, b.gr_hispanic_male, b.gr_hispanic_female,
