    as (

with src as (
  select * from IPEDS.RAW.GRAD2023
)
select
  cast(UNITID   as number) as institution_id,
  cast(GRTYPE   as varchar) as grtype_code,
  cast(CHRTSTAT as varchar) as chrtstat_code,
  cast(SECTION  as varchar) as section_code,
  cast(COHORT   as varchar) as cohort_code,
  cast(LINE     as varchar) as line_code,

  cast(GRTOTLT  as number) as gr_total_all,
  cast(GRTOTLM  as number) as gr_total_male,
  cast(GRTOTLW  as number) as gr_total_female,

  cast(GRAIANT  as number) as gr_ai_an_all,
  cast(GRAIANM  as number) as gr_ai_an_male,
  cast(GRAIANW  as number) as gr_ai_an_female,

  cast(GRASIAT  as number) as gr_asian_all,
  cast(GRASIAM  as number) as gr_asian_male,
  cast(GRASIAW  as number) as gr_asian_female,

  cast(GRBKAAT  as number) as gr_black_all,
  cast(GRBKAAM  as number) as gr_black_male,
  cast(GRBKAAW  as number) as gr_black_female,

  cast(GRHISPT  as number) as gr_hispanic_all,
  cast(GRHISPM  as number) as gr_hispanic_male,
  cast(GRHISPW  as number) as gr_hispanic_female,

  cast(GRNH PIT as number) as gr_nhpi_all,   -- fix space if needed; column was GRNHPIT
  cast(GRNH PIM as number) as gr_nhpi_male,  -- GRNHPIM
  cast(GRNH PIW as number) as gr_nhpi_female, -- GRNHPIW

  cast(GRWHITT  as number) as gr_white_all,
  cast(GRWHITM  as number) as gr_white_male,
  cast(GRWHITW  as number) as gr_white_female,

  cast(GR2MORT  as number) as gr_two_or_more_all,
  cast(GR2MORM  as number) as gr_two_or_more_male,
  cast(GR2MORW  as number) as gr_two_or_more_female,

  cast(GRUNKNT  as number) as gr_unknown_all,
  cast(GRUNKNM  as number) as gr_unknown_male,
  cast(GRUNKNW  as number) as gr_unknown_female,

  cast(GRNRALT  as number) as gr_nonresident_all,
  cast(GRNRALM  as number) as gr_nonresident_male,
  cast(GRNRALW  as number) as gr_nonresident_female
from src
    )

