  cast(GRTOTLW  as number) as gr_total_female,

  cast(GRAIANT  as number) as gr_ai_an_all,
  cast(GRAIANM  as number) as gr_ai_an_male,
  cast(GRAIANW  as number) as gr_ai_an_female,

  cast(GRASIAT  as number) as gr_asian_all,
  cast(GRASIAM  as number) as gr_asian_male,
  cast(GRASIAW  as number) as gr_asian_female,

  cast(GRBKAAT  as number) as gr_black_all,
  cast(GRBKAAM  as number) as gr_black_male,
  cast(GRBKAAW  as number) as gr_black_female,

  cast(GRHISPT  as number) as gr_hispanic_all,
